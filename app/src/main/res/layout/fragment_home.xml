<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.ai_belt_mobile.ui.home.HomeViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F8FC">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/Belt_status_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="6dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设备连接"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/Belt_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="未连接设备，点击连接"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="连接后可使用语音识别、语音播报、SOS求助等功能。"
                    android:textColor="#6B7280"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_hotspot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="修改热点凭据"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="?attr/colorPrimary"
                    app:strokeColor="?attr/colorPrimary"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/sos_container"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/Belt_status_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/sos_hold_progress"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:visibility="visible"
                app:indicatorColor="#FF3B30"
                app:indicatorDirectionCircular="clockwise"
                app:indicatorSize="300dp"
                app:trackColor="#FEE2E2"
                app:trackThickness="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emergency_button"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:text="SOS"
                android:textColor="@android:color/white"
                android:textSize="90sp"
                android:textStyle="bold"
                app:backgroundTint="#FF3B30"
                app:cornerRadius="140dp"
                app:elevation="6dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/recognition_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@color/zxing_transparent"
            android:minHeight="52dp"
            android:padding="14dp"
            android:text="@{viewModel.text}"
            android:textColor="#111827"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/sos_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voice_input_button"
            android:layout_width="450dp"
            android:layout_height="450dp"
            android:layout_marginBottom="-300dp"
            android:contentDescription="语音输入按钮"
            android:gravity="top|center_horizontal"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:iconTint="#FFFFFF"
            android:text="语音输入"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:backgroundTint="@color/blue_light"
            app:cornerRadius="225dp"
            app:iconSize="100dp"
            app:iconGravity="top"
            app:iconPadding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
